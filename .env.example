# احصل على التوكن من @BotFather على تيليجرام
BOT_TOKEN=your_bot_token_here

# مفتاح Gemini من https://aistudio.google.com/apikey
# يمكن وضع أكثر من مفتاح مفصول بفاصلة للتبديل عند نفاد الحصة
GEMINI_API_KEY=your_gemini_api_key_here

# عند مشاكل شهادة SSL على Windows (اختياري)
# GEMINI_TLS_INSECURE=1

# معرفات المطورين (مفصولة بفاصلة)
# أرسل /start للبوت ثم استخدم @userinfobot للحصول على معرفك
DEVELOPER_IDS=123456789,987654321
